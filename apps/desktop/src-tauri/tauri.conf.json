{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bolt",
  "version": "0.1.0",
  "identifier": "app.bolt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release -p bolt-shell && node scripts/copy-shell-dll.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bolt",
        "width": 920,
        "height": 620,
        "minWidth": 480,
        "minHeight": 520,
        "backgroundColor": "#0b0b0d",
        "decorations": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "shellext/bolt_shell.dll": "bolt_shell.dll" },
    "windows": { "nsis": { "installerHooks": "installer-hooks.nsh" } }
  }
}
